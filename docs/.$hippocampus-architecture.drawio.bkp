<mxfile host="app.diagrams.net" agent="Claude Code" type="device">
  <diagram id="arch" name="1 · Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a-title" value="Hippocampus — MCP decision-memory server" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="a-sub" value="A stdio MCP server. Five tools. Decision records are plain markdown in the consuming project; the vector index is a local JSON file. No network, no API key." style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- Zones -->
        <mxCell id="z-client" value="Consuming project (MCP host)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="260" height="300" as="geometry" />
        </mxCell>
        <mxCell id="z-server" value="hippocampus process (spawned per session)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="270" height="480" as="geometry" />
        </mxCell>
        <mxCell id="z-core" value="Core modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="280" height="480" as="geometry" />
        </mxCell>
        <mxCell id="z-store" value="On-disk state (in the consuming project root)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1060" y="240" width="320" height="360" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="a-agent" value="&lt;b&gt;Claude Code / any MCP agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;calls tools directly — no shell, no npm scripts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-cfg" value="&lt;b&gt;.claude/settings.json&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot;&gt;mcpServers.hippocampus&lt;br&gt;python server.py --root .&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&quot;.&quot; resolves to the host project&lt;br&gt;because CWD is set there on spawn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Server -->
        <mxCell id="a-fastmcp" value="&lt;b&gt;server.py&lt;/b&gt; — FastMCP&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;settings.ROOT = --root&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="165" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a-t1" value="&lt;b&gt;hippocampus_query&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;before any non-trivial decision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a-t2" value="&lt;b&gt;hippocampus_log&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;two-phase: suggest, then confirm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="305" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a-t3" value="&lt;b&gt;hippocampus_classify&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;dry run — writes nothing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="360" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a-t4" value="&lt;b&gt;hippocampus_list&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;browse by category / weight&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="415" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a-t5" value="&lt;b&gt;hippocampus_chain&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;recursive depends-on tree&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="230" height="45" as="geometry" />
        </mxCell>

        <!-- Core modules -->
        <mxCell id="a-classify" value="&lt;b&gt;classify.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;regex keyword rules →&lt;br&gt;weight (heavy / standard / deferred / skip)&lt;br&gt;+ one of 16 categories&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="165" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a-retriever" value="&lt;b&gt;retriever.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;cosine similarity over the index,&lt;br&gt;then expands out/in along relationships&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="270" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-indexer" value="&lt;b&gt;indexer.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;parse records · embed · build reverse links&lt;br&gt;incremental by file mtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="365" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-logger" value="&lt;b&gt;logger.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;writes the DR markdown under an&lt;br&gt;exclusive lock; patches superseded records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="460" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Embedding model -->
        <mxCell id="a-model" value="&lt;b&gt;fastembed · all-MiniLM-L6-v2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;384-dim vectors · lazily loaded once&lt;br&gt;~30 MB, cached — offline after first download&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="130" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Storage -->
        <mxCell id="a-records" value="&lt;b&gt;.decisions/records/NNNN-slug.md&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;the source of truth — human-readable,&lt;br&gt;git-committed markdown ADRs&lt;/font&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="290" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-deferred" value="&lt;b&gt;.decisions/deferred.md&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;append-only log of deliberate non-decisions&lt;/font&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="380" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a-lock" value="&lt;b&gt;.decisions/.write.lock&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;O_EXCL lock, 5s deadline — serialises ID allocation&lt;/font&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="455" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a-index" value="&lt;b&gt;.hippocampus/index.json&lt;/b&gt;&lt;font color=&quot;#555555&quot;&gt; (gitignored)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;derived cache: embeddings, relationships,&lt;br&gt;reverse links. Delete it and it rebuilds.&lt;/font&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="530" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-1" value="stdio · JSON-RPC (MCP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-agent" target="a-fastmcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-2" value="spawns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="a-cfg" target="z-server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-q1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-t1" target="a-retriever">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-t2" target="a-classify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-t2" target="a-logger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="a-t2" target="a-indexer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="a-t3" target="a-classify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-c2" value="load_index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="a-t4" target="a-indexer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-c3" value="load_index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="a-t5" target="a-indexer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-m1" value="embed()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-retriever" target="a-model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m2" value="embed()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0.5;entryY=1;" edge="1" parent="1" source="a-indexer" target="a-model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-s1" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-indexer" target="a-records">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s2" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-indexer" target="a-index">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s3" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.9;" edge="1" parent="1" source="a-logger" target="a-records">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s4" value="appends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-logger" target="a-deferred">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s5" value="acquires" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-logger" target="a-lock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s6" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.2;" edge="1" parent="1" source="a-retriever" target="a-index">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a-note" value="&lt;b&gt;Key idea:&lt;/b&gt; markdown records are the durable truth; index.json is a disposable derived cache. Every hippocampus_log triggers an incremental rebuild (mtime-gated), so the index never drifts from the records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1340" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="log" name="2 · hippocampus_log (two-phase)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="l-title" value="hippocampus_log — the write path" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l-sub" value="Two phases on purpose: the first call classifies and surfaces prior decisions so the agent can declare relationships; only the second call writes." style="text;html=1;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1000" height="22" as="geometry" />
        </mxCell>

        <mxCell id="l-start" value="Agent calls&lt;br&gt;&lt;b&gt;hippocampus_log(description)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="l-classify" value="&lt;b&gt;classify(description)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;explicit weight/category args override&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="l-skip" value="weight ==&lt;br&gt;&lt;b&gt;skip&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="l-skipout" value="&quot;Implementation-level decision —&lt;br&gt;not worth recording.&quot;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Nothing written.&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="325" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l-conf" value="&lt;b&gt;confirmed&lt;/b&gt;&lt;br&gt;== True?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="440" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- Phase 1 lane -->
        <mxCell id="l-p1zone" value="Phase 1 — suggest (no writes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="410" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="l-p1a" value="&lt;b&gt;query(root, description, 5)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;keep direct hits with score ≥ 0.20&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="460" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="l-p1b" value="Return to agent:&lt;br&gt;• classification (weight · category · reason)&lt;br&gt;• candidate related DRs with scores and Why&lt;br&gt;• &quot;call again with confirmed=True&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="545" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l-p1c" value="&lt;b&gt;Agent decides&lt;/b&gt; which candidates actually constrained the choice, and re-calls with&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;relationships=[{&quot;type&quot;:&quot;depends-on&quot;,&quot;target&quot;:&quot;DR-0001&quot;}]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="660" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- Phase 2 lane -->
        <mxCell id="l-p2zone" value="Phase 2 — commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="480" height="470" as="geometry" />
        </mxCell>
        <mxCell id="l-parse" value="Parse &lt;font face=&quot;Courier New&quot;&gt;relationships&lt;/font&gt; JSON&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;malformed → error returned, nothing written&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="600" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l-branch" value="weight?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="675" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="l-def" value="&lt;b&gt;deferred&lt;/b&gt;&lt;br&gt;append to&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot;&gt;.decisions/deferred.md&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(returns early — no index rebuild)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="770" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l-std" value="&lt;b&gt;standard&lt;/b&gt;&lt;br&gt;write_standard_record&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Why · What · Trade-off ·&lt;br&gt;Alternatives · Relationships&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="770" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l-hvy" value="&lt;b&gt;heavy&lt;/b&gt;&lt;br&gt;write_heavy_record&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;+ Consequences and&lt;br&gt;Review Trigger sections&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="770" width="130" height="90" as="geometry" />
        </mxCell>

        <mxCell id="l-lock" value="&lt;b&gt;_with_lock&lt;/b&gt; — O_EXCL on &lt;font face=&quot;Courier New&quot;&gt;.decisions/.write.lock&lt;/font&gt;, 5s deadline&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;allocate next DR-NNNN → render markdown → write file → release&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="890" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="l-sup" value="&lt;b&gt;apply_supersedes&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;for each supersedes rel, patch the target record&#39;s&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;**Status**&lt;/font&gt; line → &quot;superseded by DR-NNNN&quot;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="800" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l-reindex" value="&lt;b&gt;build_index(root, force=False)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;incremental — embeds only records whose mtime&lt;br&gt;is newer than the index, then rebuilds all reverse links&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="890" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l-done" value="Return: &quot;Record written: &lt;path&gt;&quot;&lt;br&gt;(+ any statuses updated to superseded)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="890" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="l-start" target="l-classify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="l-classify" target="l-skip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l-skip" target="l-skipout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l-skip" target="l-conf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le5" value="no → Phase 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l-conf" target="l-p1a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="l-p1a" target="l-p1b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="l-p1b" target="l-p1c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le8" value="re-call with confirmed=True" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="l-p1c" target="l-parse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le9" value="yes → Phase 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="l-conf" target="l-parse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="l-parse" target="l-branch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="l-branch" target="l-def"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="l-branch" target="l-std"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="l-branch" target="l-hvy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="l-std" target="l-lock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="l-hvy" target="l-lock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l-lock" target="l-reindex"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le17" value="if any" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0.5;entryY=1;" edge="1" parent="1" source="l-hvy" target="l-sup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="l-reindex" target="l-done"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="query" name="3 · hippocampus_query (retrieval)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="q-title" value="hippocampus_query — the read path" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="q-sub" value="Semantic search is only the first hop. Results are then expanded along the decision graph in both directions, so a hit drags its constraints in with it." style="text;html=1;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1000" height="22" as="geometry" />
        </mxCell>

        <mxCell id="q-in" value="&lt;b&gt;query_text&lt;/b&gt;, top_n = 5" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q-load" value="&lt;b&gt;load_index()&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;empty → &quot;no past constraints apply&quot;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="q-emb" value="&lt;b&gt;embed(query_text)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;384-dim vector&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="q-cos" value="&lt;b&gt;cosine similarity&lt;/b&gt; vs every entry&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;sort desc — linear scan, no ANN index&lt;br&gt;(fine at ADR scale: tens–hundreds of records)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="q-top" value="&lt;b&gt;top_n direct hits&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;surfaced_via = &quot;direct&quot;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- Expansion zone -->
        <mxCell id="q-zone" value="Graph expansion — for each direct hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="480" height="420" as="geometry" />
        </mxCell>
        <mxCell id="q-out" value="&lt;b&gt;1 · Outbound&lt;/b&gt; — follow &lt;font face=&quot;Courier New&quot;&gt;relationships&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;the DRs this hit declares it depends-on / supersedes /&lt;br&gt;conflicts-with / references&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="250" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q-inb" value="&lt;b&gt;2 · Inbound&lt;/b&gt; — follow &lt;font face=&quot;Courier New&quot;&gt;reverse_links&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;the DRs that depend on this hit — the blast radius.&lt;br&gt;Precomputed at index time, so this is a lookup, not a scan.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="345" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q-soft" value="&lt;b&gt;3 · Soft related&lt;/b&gt; — similarity ≥ 0.80&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;anything that scored very high but fell outside top_n&lt;br&gt;and has no declared link. Tagged &quot;related-to&quot;.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="440" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q-dedupe" value="&lt;b&gt;seen&lt;/b&gt; set — each DR appears at most once,&lt;br&gt;first surfacing route wins" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="535" width="420" height="55" as="geometry" />
        </mxCell>

        <mxCell id="q-fmt" value="&lt;b&gt;Formatted for the agent&lt;/b&gt; — everything inline, so no record file needs opening:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;DR-0007  [direct | score: 0.812]  (data · heavy)&lt;br&gt;&amp;nbsp;&amp;nbsp;Postgres over DynamoDB for the ledger&lt;br&gt;&amp;nbsp;&amp;nbsp;Why: relational integrity across accounts…&lt;br&gt;&amp;nbsp;&amp;nbsp;Rejected: DynamoDB — no cross-partition transactions&lt;br&gt;&amp;nbsp;&amp;nbsp;Depends on: DR-0002&lt;br&gt;&lt;br&gt;DR-0002  [via depends-on | Depends on DR-0007]  (architectural · heavy)&lt;br&gt;&amp;nbsp;&amp;nbsp;Single-writer service boundary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="200" width="520" height="230" as="geometry" />
        </mxCell>

        <mxCell id="q-why" value="&lt;b&gt;Why expansion matters:&lt;/b&gt; a purely semantic search returns what &lt;i&gt;sounds&lt;/i&gt; like the query. The relationship hops return what actually &lt;i&gt;constrains&lt;/i&gt; it — including the record that supersedes your best hit, which similarity alone would happily hide." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="470" width="520" height="80" as="geometry" />
        </mxCell>

        <mxCell id="qe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="q-in" target="q-load"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="q-load" target="q-emb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="q-emb" target="q-cos"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="q-cos" target="q-top"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-top" target="q-out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-top" target="q-inb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;exitX=1;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-top" target="q-soft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q-soft" target="q-dedupe"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qe9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="q-dedupe" target="q-fmt"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="index" name="4 · Indexing &amp; the decision graph">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="i-title" value="build_index — markdown in, vector graph out" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="i-sub" value="Runs after every hippocampus_log, and on demand with force=True. Incremental: a record is re-embedded only if its mtime is newer than the index." style="text;html=1;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1000" height="22" as="geometry" />
        </mxCell>

        <mxCell id="i-src" value="&lt;b&gt;.decisions/records/*.md&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;sorted glob&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i-gate" value="&lt;b&gt;mtime gate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;mtime ≤ index.built_at&lt;br&gt;and id already present?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="i-skip" value="&lt;b&gt;skip&lt;/b&gt; — reuse existing entry&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(no re-embedding)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="265" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i-parse" value="&lt;b&gt;_parse_file&lt;/b&gt; — regex over the markdown&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;• &lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot;&gt;# DR-NNNN: Title&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;• &lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot;&gt;**Category** **Status** **Weight** **Date**&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;• Why / Context → 220-char summary&lt;br&gt;• Alternatives → rejected-options list&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="i-rel" value="&lt;b&gt;_parse_relationships&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Explicit: bullets under &lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot;&gt;## Relationships&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;depends-on · supersedes · conflicts-with ·&lt;br&gt;overrides · inferred-by · references&lt;br&gt;&lt;br&gt;Prose fallback: a bare &lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot;&gt;DR-0004&lt;/font&gt;&lt;font color=&quot;#555555&quot;&gt; mentioned in&lt;br&gt;Why/What/Context becomes a &quot;references&quot; link&lt;br&gt;— unless already declared explicitly.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="i-embed" value="&lt;b&gt;embed(title + full content)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;fastembed · all-MiniLM-L6-v2 → 384 floats&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="415" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="i-entry" value="&lt;b&gt;IndexEntry&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot;&gt;id · title · category · status · weight · date&lt;br&gt;file_path · relationships · reverse_links&lt;br&gt;embedding · document · why · alternatives&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="540" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="i-rev" value="&lt;b&gt;Reverse-link pass&lt;/b&gt; — over the whole corpus, not just new records&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;for every A --rel--&amp;gt; B, attach the inverse to B:&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#555555&quot;&gt;depends-on ⇄ depended-on-by&lt;br&gt;supersedes ⇄ superseded-by&lt;br&gt;overrides ⇄ overridden-by&lt;br&gt;inferred-by ⇄ infers&lt;br&gt;conflicts-with ⇄ conflicts-with (symmetric)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="400" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="i-out" value="&lt;b&gt;.hippocampus/index.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;entries sorted by id · built_at = now (ms)&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="440" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- Decision graph illustration -->
        <mxCell id="g-zone" value="What the graph looks like once built" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="590" width="700" height="330" as="geometry" />
        </mxCell>

        <mxCell id="g-1" value="&lt;b&gt;DR-0001&lt;/b&gt;&lt;br&gt;Event-sourced core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="640" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g-2" value="&lt;b&gt;DR-0004&lt;/b&gt;&lt;br&gt;Postgres for the ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="750" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g-3" value="&lt;b&gt;DR-0009&lt;/b&gt;&lt;br&gt;Read models in Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="750" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g-4" value="&lt;b&gt;DR-0012&lt;/b&gt;&lt;br&gt;Kafka, not Redis Streams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="640" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g-5" value="&lt;b&gt;DR-0002&lt;/b&gt; &lt;font color=&quot;#999999&quot;&gt;(superseded)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;Redis Streams for events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1230" y="850" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ge1" value="depends-on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#f5f5f5;strokeColor=#6c8ebf;" edge="1" parent="1" source="g-2" target="g-1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge2" value="depends-on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#f5f5f5;strokeColor=#6c8ebf;" edge="1" parent="1" source="g-3" target="g-2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge3" value="depends-on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#f5f5f5;strokeColor=#6c8ebf;" edge="1" parent="1" source="g-4" target="g-1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge4" value="supersedes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#f5f5f5;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="g-4" target="g-5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="g-note" value="A query hitting &lt;b&gt;DR-0004&lt;/b&gt; also surfaces &lt;b&gt;DR-0001&lt;/b&gt; (outbound: what constrains it) and &lt;b&gt;DR-0009&lt;/b&gt; (inbound: what breaks if it changes). Logging a new record that supersedes &lt;b&gt;DR-0002&lt;/b&gt; flips that record&#39;s Status line in place — the superseded decision stays readable, but stops being live." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="800" y="620" width="150" height="290" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="ie1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="i-src" target="i-gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-gate" target="i-skip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie3" value="no / force=True" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-gate" target="i-parse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="i-parse" target="i-rel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i-parse" target="i-embed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="i-embed" target="i-entry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i-rel" target="i-entry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d6b656;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="i-entry" target="i-rev"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i-rev" target="i-out"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="session" name="5 · In-repo session flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s-title" value="What actually happens in a repo" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s-sub" value="One feature, logged. Then three weeks later, someone tries to undo it — and the memory is what stops the quiet regression." style="text;html=1;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1100" height="22" as="geometry" />
        </mxCell>

        <!-- Lifeline headers -->
        <mxCell id="s-h1" value="&lt;b&gt;Engineer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s-h2" value="&lt;b&gt;Claude Code agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s-h3" value="&lt;b&gt;Hippocampus MCP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s-h4" value="&lt;b&gt;Repo files&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="100" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s-h5" value="&lt;b&gt;git&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="100" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="s-ll1" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="145" as="sourcePoint" /><mxPoint x="140" y="1380" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s-ll2" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="145" as="sourcePoint" /><mxPoint x="440" y="1380" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s-ll3" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="145" as="sourcePoint" /><mxPoint x="760" y="1380" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s-ll4" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="145" as="sourcePoint" /><mxPoint x="1090" y="1380" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s-ll5" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="145" as="sourcePoint" /><mxPoint x="1400" y="1380" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ACT 1 band -->
        <mxCell id="s-band1" value="Sprint 4 — building the feature" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#666666;align=left;spacingLeft=10;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="40" y="165" width="1470" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&quot;Add rate limiting to the public API&quot;" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="215" as="sourcePoint" /><mxPoint x="440" y="215" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="s2" value="hippocampus_query(&quot;rate limiting public API&quot;)  ← before deciding anything" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="265" as="sourcePoint" /><mxPoint x="760" y="265" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="s3" value="read .hippocampus/index.json · embed · cosine · expand graph" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="310" as="sourcePoint" /><mxPoint x="1090" y="310" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="s4" value="DR-0006 [direct 0.74] Redis for shared counters&#10;DR-0002 [via depends-on] One Redis instance, no cluster" style="html=1;endArrow=open;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="375" as="sourcePoint" /><mxPoint x="440" y="375" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="s-n1" value="&lt;b&gt;The agent now knows the constraint&lt;/b&gt; before writing a line: Redis is already the shared-counter store, and it&#39;s single-instance. It doesn&#39;t propose a new dependency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="345" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&quot;DR-0006 already picked Redis. Token bucket there?&quot;" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="435" as="sourcePoint" /><mxPoint x="140" y="435" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s6" value="&quot;yes — but sliding window, not token bucket&quot;" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="480" as="sourcePoint" /><mxPoint x="440" y="480" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="s-code" value="agent writes&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;src/middleware/rate_limit.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="455" y="505" width="190" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="hippocampus_log(&quot;sliding-window limiter in Redis…&quot;)   — Phase 1" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="580" as="sourcePoint" /><mxPoint x="760" y="580" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s8" value="standard · performance&#10;candidates: DR-0006 (0.71), DR-0002 (0.38)" style="html=1;endArrow=open;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="640" as="sourcePoint" /><mxPoint x="440" y="640" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9" value="hippocampus_log(confirmed=True, relationships=[depends-on DR-0006])   — Phase 2" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="690" as="sourcePoint" /><mxPoint x="760" y="690" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="s10" value="write .decisions/records/0014-sliding-window-rate-limit.md   (under .write.lock)" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="740" as="sourcePoint" /><mxPoint x="1090" y="740" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s11" value="build_index(force=False) → reindex only the new record, rebuild reverse links" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="785" as="sourcePoint" /><mxPoint x="1090" y="785" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s12" value="&quot;Record written: DR-0014&quot;" style="html=1;endArrow=open;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="830" as="sourcePoint" /><mxPoint x="440" y="830" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="s13" value="git commit — &lt;b&gt;code + DR-0014.md in the same commit&lt;/b&gt;;  .hippocampus/ is gitignored" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="890" as="sourcePoint" /><mxPoint x="1400" y="890" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s-n2" value="&lt;b&gt;The reviewer sees the &quot;why&quot; in the diff&lt;/b&gt; — not just the code. The record travels with the change through PR review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="905" width="330" height="50" as="geometry" />
        </mxCell>

        <!-- ACT 2 band -->
        <mxCell id="s-band2" value="Three weeks later — new session, different engineer, zero memory of DR-0014" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#8a5a00;align=left;spacingLeft=10;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1470" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s14" value="&quot;Drop Redis — I want the limiter in-memory&quot;" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1055" as="sourcePoint" /><mxPoint x="440" y="1055" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s15" value="hippocampus_query(&quot;drop Redis, in-memory rate limiting&quot;)" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1100" as="sourcePoint" /><mxPoint x="760" y="1100" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s16" value="DR-0006 [direct]  ·  DR-0014 [via depended-on-by]  ·  DR-0011 [via depended-on-by]&#10;— the inbound expansion IS the blast radius" style="html=1;endArrow=open;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1165" as="sourcePoint" /><mxPoint x="440" y="1165" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s-n3" value="&lt;b&gt;This is the payoff.&lt;/b&gt; Without the memory the agent would have cheerfully ripped Redis out and silently broken two other decisions&#39; assumptions. Instead it reports what depends on the thing being removed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="1120" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s17" value="&quot;Removing Redis invalidates DR-0014 and DR-0011. Still want it? Then this supersedes DR-0014.&quot;" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1225" as="sourcePoint" /><mxPoint x="140" y="1225" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s18" value="hippocampus_log(confirmed=True, relationships=[supersedes DR-0014])" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1285" as="sourcePoint" /><mxPoint x="760" y="1285" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s19" value="write DR-0021.md  +  patch DR-0014 Status → &quot;superseded by DR-0021&quot;" style="html=1;endArrow=block;rounded=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1330" as="sourcePoint" /><mxPoint x="1090" y="1330" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s-n4" value="The old record isn&#39;t deleted — it stays readable, marked superseded. The repo keeps the whole argument, not just the winner." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1340" width="380" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="repo" name="6 · Repo layout &amp; where it pays off">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="r-title" value="What Hippocampus adds to a repo" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r-sub" value="Two directories. One is committed and is the product; the other is a local cache you can delete at any time." style="text;html=1;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1000" height="22" as="geometry" />
        </mxCell>

        <mxCell id="r-tree" value="&lt;font face=&quot;Courier New&quot;&gt;your-project/&lt;br&gt;├── .claude/settings.json&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#888888&quot;&gt;# registers the MCP server&lt;/font&gt;&lt;br&gt;├── .decisions/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#2d7a2d&quot;&gt;# COMMITTED — the memory&lt;/font&gt;&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── records/&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── 0001-event-sourced-core.md&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── 0006-redis-shared-counters.md&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;└── 0014-sliding-window-rate-limit.md&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── deferred.md&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#888888&quot;&gt;# what we chose NOT to decide&lt;/font&gt;&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;└── .write.lock&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#888888&quot;&gt;# transient&lt;/font&gt;&lt;br&gt;├── .hippocampus/&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;└── index.json&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#b85450&quot;&gt;# GITIGNORED — derived cache&lt;/font&gt;&lt;br&gt;└── src/ …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="620" height="290" as="geometry" />
        </mxCell>

        <mxCell id="r-c1" value="&lt;b&gt;Committed: &lt;font color=&quot;#2d7a2d&quot;&gt;.decisions/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plain markdown ADRs. Readable without the tool, reviewable in a PR diff, greppable, mergeable. If Hippocampus disappeared tomorrow you&#39;d still have the whole decision history — that&#39;s the point of not storing it in a database." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r-c2" value="&lt;b&gt;Gitignored: &lt;font color=&quot;#b85450&quot;&gt;.hippocampus/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Embeddings and reverse links, derived from the records. Never merge-conflicts, because it&#39;s never committed. Each clone builds its own on first log; &lt;font face=&quot;Courier New&quot;&gt;rm -rf .hippocampus&lt;/font&gt; is always safe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="110" width="380" height="130" as="geometry" />
        </mxCell>

        <mxCell id="r-c3" value="&lt;b&gt;Zero infrastructure&lt;/b&gt;&lt;br&gt;&lt;br&gt;No service to run, no API key, no vector DB. One local model (~30 MB, cached), then fully offline. The server is spawned per session by the MCP host and dies with it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="270" width="780" height="130" as="geometry" />
        </mxCell>

        <mxCell id="r-h2" value="Three moments where it earns its keep" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="700" height="26" as="geometry" />
        </mxCell>

        <mxCell id="r-m1" value="&lt;b&gt;1 · Before a decision&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;hippocampus_query&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;The agent is about to pick a library, a schema, an interface. It asks first, and finds the fork was already resolved — with the rejected alternatives spelled out. No re-litigating a settled argument, no accidentally choosing the thing that was already rejected for a reason nobody wrote down anywhere else." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="r-m2" value="&lt;b&gt;2 · Before a change&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;hippocampus_chain / reverse links&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Someone wants to rip out a dependency or reshape a boundary. The inbound expansion answers the question code search can&#39;t: &lt;i&gt;which past decisions assumed this?&lt;/i&gt; The blast radius is a graph walk, not an archaeology project." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="r-m3" value="&lt;b&gt;3 · On day one&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;hippocampus_list&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;A new engineer — or a fresh agent session with no context — browses by category (&lt;font face=&quot;Courier New&quot;&gt;security&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;data&lt;/font&gt;) or by weight (&lt;font face=&quot;Courier New&quot;&gt;heavy&lt;/font&gt;) and reads the load-bearing decisions with their Why inline. The repo explains itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="480" width="440" height="180" as="geometry" />
        </mxCell>

        <mxCell id="r-foot" value="&lt;b&gt;The failure mode it&#39;s built against:&lt;/b&gt; an agent with a fresh context window has no idea what the team already argued about. It re-derives, re-decides, and quietly contradicts. Git history records &lt;i&gt;what changed&lt;/i&gt;; the code records &lt;i&gt;what is&lt;/i&gt;. Neither records &lt;i&gt;what was rejected and why&lt;/i&gt; — and that&#39;s the part that keeps getting relearned the expensive way." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1440" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
